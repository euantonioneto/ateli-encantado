{
  "expo": {
    "name": "atelie-encantado",
    "slug": "atelie-encantado",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/atelie-app-icon.png",
    "scheme": "atelieencantado",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/atelie-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/atelie-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo/logo2.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
